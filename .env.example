JWT_SECRET=replace_this_with_a_strong_secret
JWT_REFRESH_SECRET=replace_this_with_another_strong_secret
JWT_REFRESH_EXPIRES_IN=10y
# Leave JWT_ACCESS_EXPIRES_IN unset so sessions only end through explicit logout.
NODE_ENV=production
PORT=3000
EASYCRED_DB_PATH=./data.db
# Required in production/Vercel. Use a real Postgres database URL.
# VPS/local development can omit this and use the SQLite file above.
DATABASE_URL=

# Optional Telegram bot. Create the token with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=true
# Optional comma-separated chat IDs. Leave empty to allow any chat that has the bot.
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional company ID. Leave empty to use the first company.
TELEGRAM_COMPANY_ID=
TELEGRAM_SHOW_PROFIT=false
TELEGRAM_POLLING_INTERVAL_MS=2500

# Optional WhatsApp bot. Run with: npm run start:whatsapp
WHATSAPP_AUTH_DIR=auth_info
WHATSAPP_TIMEZONE=America/Sao_Paulo
WHATSAPP_BOT_FOOTER=Junior Cred
WHATSAPP_DEBUG=false
WHATSAPP_OWNER_JID=5527997584986@s.whatsapp.net
WHATSAPP_ATTENDANT_PHONE=5527997584986
WHATSAPP_AMOUNT_PRESETS=1000,2000,3000,4000,5000
WHATSAPP_INSTALLMENT_PRESETS=3,6,10,12,18
WHATSAPP_SESSION_TTL_MINUTES=30
# Private chat is paused when you answer manually, then returns automatically.
WHATSAPP_HUMAN_PAUSE_HOURS=12

# Optional daily art post to a WhatsApp group. The bot will not answer group messages.
WHATSAPP_DAILY_GROUP_JID=
WHATSAPP_DAILY_ART_PATH=
# Optional comma-separated rotation. When set, it is used instead of WHATSAPP_DAILY_ART_PATH.
WHATSAPP_DAILY_ART_PATHS=
WHATSAPP_DAILY_ART_CAPTION=
WHATSAPP_DAILY_ART_TIME=09:00

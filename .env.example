JWT_SECRET=replace_this_with_a_strong_secret
JWT_REFRESH_SECRET=replace_this_with_another_strong_secret
JWT_REFRESH_EXPIRES_IN=10y
# Leave JWT_ACCESS_EXPIRES_IN unset so sessions only end through explicit logout.
NODE_ENV=production
PORT=3000
EASYCRED_DB_PATH=./data.db
# Required in production/Vercel. Use a real Postgres database URL.
# VPS/local development can omit this and use the SQLite file above.
DATABASE_URL=
